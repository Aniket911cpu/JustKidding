{
    "manifest_version": 3,
    "name": "Funny Popup",
    "version": "1.0",
    "description": "Shows a funny popup with a GIF, joke, and laughing sound.",
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
      }
    },
    "permissions": [
      "activeTab"
    ]
  }